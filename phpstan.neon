includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    scanFiles:
        - tests/Support/wordpress-tests.stub
        - tests/Support/mpdf-prefixed.stub
        - tests/Support/action-scheduler.stub
    paths:
        - src
        - rental-manager.php
        - bin
        - tests
        - tools
