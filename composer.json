{
    "name": "rental-manager/rental-manager",
    "description": "Arabic-first rental management for WordPress.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "woocommerce/action-scheduler": "^3.9",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.31",
        "nikic/php-parser": "^5.9",
        "phpunit/phpunit": "^10.5",
        "deptrac/deptrac": "^2.0",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {"RentalManager\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "RentalManager\\Tests\\": "tests/",
            "RentalManager\\Architecture\\": "tools/Architecture/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.0"},
        "allow-plugins": false
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "RentalManager\\Vendor\\",
            "classmap_prefix": "RentalManager_Vendor_",
            "constant_prefix": "RENTAL_MANAGER_VENDOR_",
            "include_root_autoload": true,
            "update_call_sites": false,
            "exclude_from_prefix": {
                "packages": ["woocommerce/action-scheduler"]
            },
            "exclude_from_copy": {
                "packages": ["woocommerce/action-scheduler"]
            }
        }
    },
    "scripts": {
        "prefix-namespaces": "strauss",
        "post-install-cmd": "@prefix-namespaces",
        "post-update-cmd": "@prefix-namespaces",
        "test:unit": "phpunit --testsuite Unit,Application,Architecture",
        "test:integration": "phpunit -c phpunit.integration.xml.dist --testsuite Integration,Api",
        "test:arch": ["@php bin/check-architecture.php", "@php bin/check-sql.php", "deptrac analyse --no-progress --fail-on-uncovered"],
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "phpcs",
        "lint": "@php bin/lint.php",
        "check": ["@lint", "@test:unit", "@test:arch", "@stan", "@cs"]
    }
}
