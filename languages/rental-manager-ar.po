msgid ""
msgstr ""
"Language: ar\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Database schema"
msgstr "مخطط قاعدة البيانات"

msgid "Stored: %1$s; plugin: %2$s; failed migration: %3$s"
msgstr "الإصدار المسجل: %1$s؛ إصدار الإضافة: %2$s؛ الترحيل المتعثر: %3$s"

msgid "Not installed"
msgstr "غير مثبت"

msgid "None"
msgstr "لا يوجد"

msgid "Rental Manager is waiting for a database upgrade."
msgstr "مدير الإيجارات بانتظار تحديث قاعدة البيانات."

msgid "Open System Health"
msgstr "فتح سلامة النظام"

msgid "Migration recovery"
msgstr "استرجاع ترحيلات قاعدة البيانات"

msgid "The journal could not be read. Check database access before retrying."
msgstr "تعذرت قراءة سجل الترحيلات. تحقّق من الاتصال بقاعدة البيانات قبل إعادة المحاولة."

msgid "Incomplete migrations"
msgstr "ترحيلات غير مكتملة"

msgid "An incomplete migration must be reconciled with the actual schema before retrying. Verify every effect, then reconcile its journal entry; never delete history blindly."
msgstr "يجب مطابقة الترحيل غير المكتمل مع مخطط قاعدة البيانات الفعلي قبل إعادة المحاولة. تحقّق من كل تغيير ثم صحّح حالة سجله بما يطابق الواقع؛ لا تحذف السجل دون تحقق."

msgid "Retry migrations"
msgstr "إعادة محاولة الترحيلات"

msgid "You are not allowed to retry migrations."
msgstr "غير مسموح لك بإعادة محاولة الترحيلات."

msgid "Retry migrations requires POST."
msgstr "تتطلب إعادة محاولة الترحيلات طلب POST."

msgid "Rental Manager could not update its database. Ask the administrator to check the migration journal."
msgstr "تعذر تحديث قاعدة بيانات مدير الإيجارات. اطلب من مسؤول النظام مراجعة سجل ترحيل قاعدة البيانات."

msgid "Download sample PDF"
msgstr "تحميل ملف PDF التجريبي"

msgid "Information"
msgstr "معلومة"

msgid "Not reported"
msgstr "غير متاح"

msgid "Web server software"
msgstr "برنامج خادم الويب"

msgid "WordPress version"
msgstr "إصدار ووردبريس"

msgid "You are not allowed to download the sample PDF."
msgstr "غير مسموح لك بتحميل ملف PDF التجريبي."

msgid "PDF downloads require POST."
msgstr "يتطلب تحميل ملف PDF طلب POST."

msgid "The sample PDF could not be generated. Check hosting requirements and try again."
msgstr "تعذر إنشاء ملف PDF التجريبي. تحقّق من متطلبات الاستضافة وحاول مجددًا."

msgid "Rental Manager"
msgstr "مدير الإيجارات"

msgid "System Health"
msgstr "سلامة النظام"

msgid "You are not allowed to view System Health."
msgstr "غير مسموح لك بعرض سلامة النظام."

msgid "Run hosting diagnostics. Temporary database tables and files are removed; a scheduler canary may stay pending."
msgstr "شغّل فحوص الاستضافة. تُحذف الجداول والملفات المؤقتة؛ وقد يظل اختبار المجدول قيد الانتظار."

msgid "Run checks"
msgstr "تشغيل الفحوص"

msgid "Check"
msgstr "الفحص"

msgid "Status"
msgstr "الحالة"

msgid "Details"
msgstr "التفاصيل"

msgid "Pass"
msgstr "ناجح"

msgid "Fail"
msgstr "فشل"

msgid "Pending"
msgstr "قيد الانتظار"

msgid "PHP 8.1 or later"
msgstr "PHP بإصدار 8.1 أو أحدث"

msgid "Sodium extension"
msgstr "إضافة Sodium"

msgid "Mbstring extension"
msgstr "إضافة Mbstring"

msgid "GD or Imagick extension"
msgstr "إضافة GD أو Imagick"

msgid "Memory limit at least 256 MB"
msgstr "حد الذاكرة ٢٥٦ ميجابايت على الأقل"

msgid "WP-Cron disabled for system cron"
msgstr "تعطيل WP-Cron لاستخدام مجدول النظام"

msgid "Database diagnostic could not complete"
msgstr "تعذر إكمال فحص قاعدة البيانات"

msgid "MySQL 5.7.44 or MariaDB 10.6 or later"
msgstr "MySQL 5.7.44 أو MariaDB 10.6 أو أحدث"

msgid "Warning"
msgstr "تحذير"

msgid "MySQL 5.7 is end-of-life upstream"
msgstr "انتهى الدعم الرسمي لـ MySQL 5.7"

msgid "Default storage engine is InnoDB"
msgstr "محرك التخزين الافتراضي هو InnoDB"

msgid "Foreign keys reject invalid references and probe tables are removed"
msgstr "المفاتيح الخارجية ترفض المراجع غير الصالحة مع حذف جداول الاختبار"

msgid "Transaction rollback removes the probe row"
msgstr "التراجع عن المعاملة يحذف صف الاختبار"

msgid "Private storage HTTP canary"
msgstr "اختبار حماية التخزين الخاص عبر HTTP"

msgid "Action Scheduler canary execution"
msgstr "تنفيذ اختبار Action Scheduler"

msgid "Action Scheduler canary timed out"
msgstr "انتهت مهلة اختبار Action Scheduler"

msgid "Canary queued; run checks again within two minutes"
msgstr "أُضيف الاختبار إلى قائمة الانتظار؛ أعد تشغيل الفحوص خلال دقيقتين"

msgid "Rental Manager requires PHP 8.1 or later and WordPress 7.0 or later."
msgstr "يتطلب مدير الإيجارات PHP بإصدار 8.1 أو أحدث ووردبريس بإصدار 7.0 أو أحدث."

msgid "Rental Manager is missing its dependencies. Install a complete release or run composer install."
msgstr "مكتبات مدير الإيجارات غير مكتملة. ثبّت حزمة إصدار كاملة أو شغّل composer install."
